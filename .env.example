# Required in production, falls back to in-memory store in development if omitted or unreachable
DATABASE_URL=
PAYSTACK_SECRET_KEY=
SUCCESS_BIZ_HUB_API_KEY=
SUCCESS_BIZ_HUB_BASE_URL=
SUCCESS_BIZ_HUB_FULFILLMENT_ENABLED=
SUCCESS_BIZ_HUB_REQUEST_TIMEOUT_MS=
# Required for supplier webhooks in production. Missing secret returns HTTP 503; invalid signatures return 401.
SUCCESS_BIZ_HUB_WEBHOOK_SECRET=
VITE_API_BASE_URL=
VITE_PAYSTACK_PUBLIC_KEY=

# Website Builder signed media uploads. API secret is SERVER-ONLY; never use a VITE_ prefix.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional bounded Free defaults: 20 images/site; 8 MiB/source image.
WEBSITE_FREE_MAX_ASSETS=20
WEBSITE_IMAGE_MAX_BYTES=8388608

# Mystery Hub Environment Configuration

# Server Port
PORT=3000

# Server API Base URL (for frontend-backend separation e.g. Netlify + Render)
# Leave empty for relative paths during local development
VITE_API_BASE_URL=""

# Paystack Payment Provider Settings
# PAYSTACK_SECRET_KEY: Server-only secret key used to initialize & verify transactions and validate incoming webhook HMAC SHA512 signatures
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
# VITE_PAYSTACK_PUBLIC_KEY: Safe client-side public key for Paystack Pop inline dialog
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Success Biz Hub Supplier API v2 Settings (SERVER-ONLY - Never prefix with VITE_)
# SUCCESS_BIZ_HUB_API_KEY: Live secret API key for Success Biz Hub v2 (e.g. sbh_live_...)
SUCCESS_BIZ_HUB_API_KEY=""
# SUCCESS_BIZ_HUB_BASE_URL: Canonical base URL for Success Biz Hub API v2
SUCCESS_BIZ_HUB_BASE_URL="https://api.successbizhub.com/v2"
# SUCCESS_BIZ_HUB_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification of incoming supplier webhooks
SUCCESS_BIZ_HUB_WEBHOOK_SECRET=""
# SUCCESS_BIZ_HUB_FULFILLMENT_ENABLED: Toggle for live automated dispatch. Defaults to false.
SUCCESS_BIZ_HUB_FULFILLMENT_ENABLED="false"
# SUCCESS_BIZ_HUB_REQUEST_TIMEOUT_MS: HTTP client request timeout in milliseconds (default: 15000)
SUCCESS_BIZ_HUB_REQUEST_TIMEOUT_MS="15000"

# Database Connection URL (PostgreSQL - Supabase / Cloud SQL / Render / Neon)
# If omitted, server utilizes persistent development fallback store
DATABASE_URL="postgresql://user:password@localhost:5432/mysteryhub"

# Google Gemini API Key (Injected automatically in AI Studio environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
